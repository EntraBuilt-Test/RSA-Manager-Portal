# MongoDB connection string.
# Local dev:      mongodb://127.0.0.1:27017/rsa_construction
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rsa_construction?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/rsa_construction

# Server
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - frontend origin allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Business rules
LOW_STOCK_THRESHOLD_PERCENT=15

# AI Assistant (optional) - leave GROQ_API_KEY blank to fall back to the
# built-in free keyword-based assistant. To get real LLM answers instead:
# 1. Sign up at https://console.groq.com (free tier available)
# 2. Create an API key and paste it below
GROQ_API_KEY=
# Optional: override the Groq model (defaults to llama-3.3-70b-versatile).
# See https://console.groq.com/docs/models for current model names.
GROQ_MODEL=llama-3.3-70b-versatile

# Vehicle photo storage (Cloudinary) - required for the "vehicle photo" feature.
# 1. Sign up free at https://cloudinary.com (no credit card needed).
# 2. On your Cloudinary Dashboard, copy these 3 values into the fields below.
# Without these set, vehicle photo uploads will fail with a clear setup error;
# the rest of the app (billing, stock, etc.) is unaffected.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

